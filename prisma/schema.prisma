// QUÉ ES: la estructura de la base: cada model es una tabla de PostgreSQL.
// NIVEL: base de datos — es la fuente de verdad de las tablas. A partir de este
// archivo Prisma genera el cliente (src/generated/prisma) y las migraciones.
// DÓNDE SE USA: npx prisma generate y npx prisma migrate dev lo leen;
// PrismaService usa el cliente generado.
//
// Las tablas se crean con las migraciones de prisma/migrations (npx prisma
// migrate dev). Si cambia una tabla: se edita este archivo y se corre
// npx prisma migrate dev --name <qué-cambia>, que crea una migración nueva.
//
// Los models y campos tienen nombres de TypeScript (Plan, discountNote).
// @@map y @map dicen cómo se llaman de verdad en la base (plans, discount_note).
//
// Los CHECK de la base (estados, montos > 0, formato del DNI) no se pueden
// escribir acá: están al final de la migración init, agregados a mano, y los
// DTOs repiten esas reglas. Un CHECK nuevo se agrega igual: se crea la
// migración con --create-only, se le suma el ALTER TABLE y después se aplica.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Roles: los actores primarios del diagrama de casos de uso (versión 2).
model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique @db.VarChar(30)
  description String @db.VarChar(150)
  users       User[]

  @@map("roles")
}

// Cuentas de quienes usan el sistema.
model User {
  id                   Int                  @id @default(autoincrement())
  roleId               Int                  @map("role_id")
  fullName             String               @map("full_name") @db.VarChar(100)
  email                String               @unique @db.VarChar(120)
  passwordHash         String               @map("password_hash") @db.VarChar(255)
  isActive             Boolean              @default(true) @map("is_active")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  role                 Role                 @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdEnrollments   Enrollment[]
  recordedCertificates MedicalCertificate[]
  verifiedPayments     Payment[]

  @@map("users")
}

// Grupo familiar: cada persona integra como mucho uno.
model FamilyGroup {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(60)
  maxMembers Int      @map("max_members") @db.SmallInt
  persons    Person[]

  @@map("family_groups")
}

// Padrón único de vecinos: cada DNI aparece una sola vez.
model Person {
  id                  Int                  @id @default(autoincrement())
  familyGroupId       Int?                 @map("family_group_id")
  dni                 String               @unique @db.VarChar(8)
  firstName           String               @map("first_name") @db.VarChar(60)
  lastName            String               @map("last_name") @db.VarChar(60)
  birthDate           DateTime             @map("birth_date") @db.Date
  email               String?              @db.VarChar(120)
  phone               String?              @db.VarChar(30)
  familyGroup         FamilyGroup?         @relation(fields: [familyGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  consents            Consent[]
  enrollments         Enrollment[]
  medicalCertificates MedicalCertificate[]
  memberships         MembershipMember[]

  @@map("persons")
}

// Planes del abono. Los campos son los que muestra el front en /planes; el
// precio mensual no va acá porque cambia con cada cuadro tarifario.
model Plan {
  id           String       @id @db.VarChar(30)
  name         String       @unique @db.VarChar(60)
  type         String       @db.VarChar(20)
  people       String       @db.VarChar(40)
  description  String       @db.VarChar(200)
  discountNote String?      @map("discount_note") @db.VarChar(200)
  badge        String?      @db.VarChar(40)
  enrollments  Enrollment[]
  prices       Price[]

  @@map("plans")
}

// Temporada del abono.
model Season {
  id         Int         @id @default(autoincrement())
  name       String      @unique @db.VarChar(40)
  startDate  DateTime    @map("start_date") @db.Date
  endDate    DateTime    @map("end_date") @db.Date
  rateTables RateTable[]

  @@map("seasons")
}

// Cuadro tarifario: los precios que rigen en una temporada, según la
// resolución municipal.
model RateTable {
  id         Int     @id @default(autoincrement())
  seasonId   Int     @map("season_id")
  resolution String  @unique @db.VarChar(40)
  season     Season  @relation(fields: [seasonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  prices     Price[]

  @@map("rate_tables")
}

// Precio de cada plan dentro de un cuadro tarifario.
model Price {
  rateTableId Int       @map("rate_table_id")
  planId      String    @map("plan_id") @db.VarChar(30)
  amount      Decimal   @db.Decimal(10, 2)
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rateTable   RateTable @relation(fields: [rateTableId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([rateTableId, planId])
  @@map("prices")
}

// Solicitud de inscripción: existe desde que el vecino se anota, aunque
// todavía no haya pagado. procedureDate es la fecha real del trámite y
// loadedAt cuándo se cargó (difieren si se tomó en papel).
model Enrollment {
  id            Int         @id @default(autoincrement())
  personId      Int         @map("person_id")
  planId        String      @map("plan_id") @db.VarChar(30)
  createdBy     Int         @map("created_by")
  status        String      @default("pendiente") @db.VarChar(20)
  procedureDate DateTime    @map("procedure_date") @db.Date
  loadedAt      DateTime    @default(now()) @map("loaded_at") @db.Timestamptz(6)
  creator       User        @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  person        Person      @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan          Plan        @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membership    Membership?
  payments      Payment[]

  // Evita cargar dos veces el mismo formulario de papel.
  @@unique([personId, planId, procedureDate])
  @@map("enrollments")
}

// Pago informado: el dinero no pasa por el complejo, se registra la
// transferencia. El número de operación único detecta comprobantes repetidos.
model Payment {
  id              Int        @id @default(autoincrement())
  enrollmentId    Int        @map("enrollment_id")
  method          String     @default("transferencia") @db.VarChar(20)
  amount          Decimal    @db.Decimal(10, 2)
  paidOn          DateTime   @map("paid_on") @db.Date
  operationNumber String     @unique @map("operation_number") @db.VarChar(30)
  status          String     @default("pendiente") @db.VarChar(20)
  verifiedBy      Int?       @map("verified_by")
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifier        User?      @relation(fields: [verifiedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("payments")
}

// Abono: recién existe cuando el pago está acreditado. Una inscripción
// origina como mucho un abono, con su constancia numerada.
model Membership {
  id                Int                @id @default(autoincrement())
  enrollmentId      Int                @unique @map("enrollment_id")
  certificateNumber String             @unique @map("certificate_number") @db.VarChar(20)
  status            String             @default("activo") @db.VarChar(20)
  validFrom         DateTime           @map("valid_from") @db.Date
  validTo           DateTime           @map("valid_to") @db.Date
  enrollment        Enrollment         @relation(fields: [enrollmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members           MembershipMember[]

  @@map("memberships")
}

// Un abono cubre a una o más personas (plan familiar) y una persona puede
// tener varios abonos en el tiempo: relación muchos a muchos.
model MembershipMember {
  membershipId Int        @map("membership_id")
  personId     Int        @map("person_id")
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  person       Person     @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  carnet       Carnet?

  @@id([membershipId, personId])
  @@map("membership_members")
}

// Carnet de cada persona cubierta por un abono.
model Carnet {
  id               Int              @id @default(autoincrement())
  membershipId     Int              @map("membership_id")
  personId         Int              @map("person_id")
  number           String           @unique @db.VarChar(20)
  status           String           @default("vigente") @db.VarChar(20)
  // FK compuesta: el carnet solo puede ser de alguien cubierto por ese abono.
  membershipMember MembershipMember @relation(fields: [membershipId, personId], references: [membershipId, personId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([membershipId, personId])
  @@map("carnets")
}

// Aptos médicos: se guarda el historial, por eso una persona puede tener varios.
model MedicalCertificate {
  id         Int      @id @default(autoincrement())
  personId   Int      @map("person_id")
  recordedBy Int      @map("recorded_by")
  issuedOn   DateTime @map("issued_on") @db.Date
  validUntil DateTime @map("valid_until") @db.Date
  person     Person   @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recorder   User     @relation(fields: [recordedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("medical_certificates")
}

// Consentimiento para tratar datos de salud, otorgado por el vecino o su tutor.
model Consent {
  id       Int      @id @default(autoincrement())
  personId Int      @map("person_id")
  givenOn  DateTime @map("given_on") @db.Date
  scope    String   @db.VarChar(120)
  person   Person   @relation(fields: [personId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("consents")
}

// Canchas en alquiler. units es cuántas canchas iguales hay de cada tipo.
model Court {
  id          String    @id @db.VarChar(30)
  activity    String    @db.VarChar(20)
  name        String    @unique @db.VarChar(60)
  detail      String    @db.VarChar(120)
  units       Int       @db.SmallInt
  memberPrice Decimal   @map("member_price") @db.Decimal(10, 2)
  publicPrice Decimal   @map("public_price") @db.Decimal(10, 2)
  bookings    Booking[]

  @@map("courts")
}

// Quien alquila una cancha. No va a persons porque el alquiler también está
// abierto a quien no es socio. Sus datos se guardan una sola vez por DNI: si
// estuvieran en bookings, el nombre y el teléfono dependerían del DNI y no de
// la reserva (dependencia transitiva), y se repetirían en cada reserva (3FN).
model Renter {
  id       Int       @id @default(autoincrement())
  dni      String    @unique @db.VarChar(8)
  fullName String    @map("full_name") @db.VarChar(120)
  phone    String    @db.VarChar(30)
  bookings Booking[]

  @@map("renters")
}

// Reserva de un turno de una hora. isMember y price son una foto del momento
// de la reserva: si después el que alquila deja de ser socio o cambia el
// precio de la cancha, la reserva conserva lo que se cobró. Por eso dependen
// de la reserva y van acá.
model Booking {
  id          Int      @id @default(autoincrement())
  courtId     String   @map("court_id") @db.VarChar(30)
  courtNumber Int      @default(1) @map("court_number") @db.SmallInt
  date        DateTime @db.Date
  hour        Int      @db.SmallInt
  renterId    Int      @map("renter_id")
  isMember    Boolean  @default(false) @map("is_member")
  price       Decimal  @db.Decimal(10, 2)
  court       Court    @relation(fields: [courtId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  renter      Renter   @relation(fields: [renterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Una misma cancha no se puede reservar dos veces en el mismo turno.
  @@unique([courtId, courtNumber, date, hour])
  @@map("bookings")
}
